# =============================================================================
# IBMS Enterprise — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# === Application ===
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING

# === MongoDB ===
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=ibms_enterprise

# === MariaDB ===
MARIADB_URI=mysql+aiomysql://ibms_user:CHANGE_ME@mariadb:3306/ibms_enterprise

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Google Cloud Platform ===
GCP_PROJECT_ID=total-handler-463313-e2
GCP_REGION=asia-south1
GCP_ARTIFACT_REGISTRY=ibms-docker
GCP_CLOUD_RUN_SERVICE=ibms-web
GCP_CLOUD_SQL_INSTANCE=ibms-mysql
