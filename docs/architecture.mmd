	subgraph L1[1. Actors and Business Use Cases]
		direction LR
		ACT[Actors<br/>Executive, Finance, Compliance, Operations, Admin, External Partner]
		UC[Use Cases<br/>KPI dashboards, AI insights, risk & forecast, compliance audits<br/>workflow optimization, integrations, secure access, operations]
		ACT --> UC
	end

	subgraph L2[2. Experience and Edge]
		direction LR
		WEB[Frontend SPA<br/>frontend/index.html + static/js/app.js]
		WS[Live Updates<br/>WebSocket KPI Stream]
		EDGE[Nginx Reverse Proxy<br/>nginx.conf]
		WEB --> WS
		WEB --> EDGE
	end

	subgraph L3[3. API and Application Core]
		direction LR
		subgraph API[API Surface]
			direction TB
			REST[REST APIs<br/>auth.py, dashboard.py, rest.py]
			GQL[GraphQL APIs<br/>graphql_api.py, graphql_schema.py]
			AIA[AI APIs<br/>ai_assistant.py, ai_copilot.py]
			ANL[Analytics, Risk, Forecast APIs<br/>analytics.py, risk.py, forecast.py]
			INT[Integrations API<br/>integrations.py]
		end

		subgraph CORE[Business and Security Core]
			direction TB
			ENG[Domain Engines<br/>risk_scoring_engine, compliance_engine<br/>digital_twin, auto_budget_optimizer]
			SVC[Business Services<br/>services/*]
			SEC[Security Controls<br/>JWT, RBAC, audit, zero-trust]
			MON[Monitoring and Tracing<br/>healthcheck, metrics, tracing]
		end
	end

	subgraph L4[4. Async and Event Processing]
		direction LR
		EVT[Event Pipeline<br/>publisher, event_router, subscriber, stream_processor]
		JOB[Background Jobs<br/>kpi_rollup, compliance_check, nightly_kpi_refresh<br/>auto_workflow_optimizer]
		EVT --> JOB
	end

	subgraph L5[5. Data Layer]
		direction LR
		MONGO[(MongoDB<br/>users, kpi_snapshots, audit_logs, rules)]
		REDIS[(Redis<br/>cache, queues, sessions, rate limits)]
	end

	subgraph L6[6. External Systems and Deployment]
		direction LR
		EXT[External Systems<br/>Frappe ecosystem, webhooks, third-party services]
		DEP[Deployment and Infra<br/>Docker Compose, Kubernetes, AWS Terraform]
	end

